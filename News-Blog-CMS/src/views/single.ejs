<div class="post-container">
    <div class="post-content single-post">
        <h3><%= singleNews.title %></h3>
        <div class="post-information">
            <span>
                <i class="fa fa-tags" aria-hidden="true"></i>
                <%= singleNews.category.name %>
            </span>
            <span>
                <i class="fa fa-user" aria-hidden="true"></i>
                <a href='/author/<%= singleNews.author._id %>'><%= singleNews.author.fullName %></a>
            </span>
            <span>
                <i class="fa fa-calendar" aria-hidden="true"></i>
                <%= new Date(singleNews.createdAt).toLocaleDateString('en-GB', { day: '2-digit' ,
                                    month: 'long' , year: 'numeric' }) %>
            </span>
        </div>
        <img class="single-feature-image" src="/upload/<%= singleNews.image %>" alt="" />
        <p class="description">
             <%= singleNews.content.replace(/<[^>]*>/g, '') %>
        </p>
    </div>
</div>