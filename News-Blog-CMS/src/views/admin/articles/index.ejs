<div id="admin-content">
  <div class="container">
    <div class="row">
      <div class="col-md-10">
        <h1 class="admin-heading"><i class="fa fa-file-text"></i> All Articles</h1>
      </div>
      <div class="col-md-2">
        <a class="add-new" href="/admin/add-article">Add New Article</a>
      </div>
      <%- include('../partials/error-msg') %>
      <div class="col-md-12">
        <div id="article-list"></div>
      </div>
    </div>
  </div>
</div>
<script id="article-data" type="application/json">
  <%- JSON.stringify(typeof articles !== "undefined" ? articles : []) %>
</script>
<script src="https://unpkg.com/tabulator-tables@6.0.0/dist/js/tabulator.min.js"></script>
<script>
  const tableData = JSON.parse(document.getElementById("article-data").textContent || "[]");

  console.log(tableData)
  let table = new Tabulator("#article-list", {
    data: tableData,
    layout: "fitColumns",
    pagination: true,
    paginationSize: 10,
    paginationSizeSelector: [5, 10, 25, 50, 100],
    columns: [{
        title: "S.No.",
        formatter: "rownum",
        width: 100,
        hozAlign: "center"
      },
      {
        title: "Title",
        field: "title",
        headerFilter: "input"
      },
      {
        title: "Category",
        field: "category.name",
        headerFilter: "input"
      },
      {
        title: "Date",
        field: "createdAt",
        headerFilter: "input",
        formatter: function(cell, formatterParams, onRendered) {
          var date = new Date(cell.getValue());
          return date.toLocaleDateString('en-GB', {
            day: '2-digit',
            month: 'short',
            year: 'numeric'
          }).replace(/\s/g, '-');
        }
      },
      {
        title: "Author",
        field: "author.fullName",
        headerFilter: "input"
      },
      {
        title: "Actions",
        formatter: function(cell, formatterParams, onRendered) {
          return `<a href="/admin/update-article/${cell.getData()._id}" class="btn btn-sm btn-success">Edit</a>
                    <button class="btn btn-sm btn-danger delete-article" onclick="deleteArticle('${cell.getData()._id}')">Delete</button>`;
        }
      }
    ],
  });

  async function deleteArticle(articleId) {
    try {
      if (confirm('Are you sure want to delete this article ?')) {

        const response = await fetch(`/admin/delete-article/${articleId}`, {
          method: 'DELETE'
        });

        if (response.ok) {
          const data = await response.json();
          alert(data.message);
          window.location.reload();
        }

        if (response.status == 400) {
          const data = await response.json();
          alert(data.message);
        }
      }
    } catch (err) {
      alert('Something Went Wrong');
    }
  }
</script>
<%- contentFor('tabulatorCSS') %>
<link href="https://unpkg.com/tabulator-tables@6.0.0/dist/css/tabulator.min.css" rel="stylesheet">